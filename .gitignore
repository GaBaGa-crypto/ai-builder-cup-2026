# 白名單：只追蹤程式、規格與部署檔；資料、報表、論文、交接檔一律不進版控
/*
!/.gitignore
!/.gcloudignore
!/README.md
!/Dockerfile
!/deploy/
!/proto/
/proto/*
!/proto/scripts/
!/design/
/design/*
!/design/bdd-*.md
!/design/prereg-*
__pycache__/
*.pyc
*.wav
*.mp3
*.sqlite
*.npz
*.csv
*.xlsx
*.pdf
*.png
# 代理人程式（agent/）與入口腳本（scripts/）；資料與產出一律不追蹤
!/agent/
!/scripts/
/agent/work/
*.parquet
*.flac
*.mp4
*.jsonl
.env
